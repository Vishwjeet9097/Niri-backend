# Comment Structure Testing
# This file tests the new comment structure with section groups

@baseUrl = http://localhost:3000
@nodalToken = {{nodalLogin.response.body.$.data.accessToken}}

### Step 1: Login as NODAL_OFFICER
# @name nodalLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nodal@niri.gov.in",
  "password": "Nodal@123"
}

### Step 2: Create a test submission
# @name createSubmission
POST {{baseUrl}}/submission
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "submissionId": "COMMENT-STRUCTURE-TEST-{{$timestamp}}",
  "formData": {
    "generalInformation": {
      "title": "Comment Structure Test",
      "department": "Infrastructure",
      "referenceNumber": "CST-2025-001",
      "submissionDate": "2025-10-14"
    },
    "infrastructureMetrics": {
      "qualityIndex": 7.8,
      "socialImpact": 8.2
    }
  }
}

### Store the UUID for use in other requests
@submissionUuid = {{createSubmission.response.body.$.data.id}}

### Step 3: Add comments to different sections
# Comment for general section
POST {{baseUrl}}/submission/{{submissionUuid}}/comment
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "text": "General comment about the submission",
  "type": "comment",
  "sectionId": "general"
}

### Add infrastructure section comment
POST {{baseUrl}}/submission/{{submissionUuid}}/comment
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "text": "Comment about infrastructure metrics",
  "type": "comment",
  "sectionId": "infrastructureMetrics"
}

### Add specific field comment
POST {{baseUrl}}/submission/{{submissionUuid}}/comment
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "text": "Comment about social impact specifically",
  "type": "comment",
  "sectionId": "infrastructureMetrics.socialImpact"
}

### Add budget section comment
POST {{baseUrl}}/submission/{{submissionUuid}}/comment
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "text": "Comment about budget allocation",
  "type": "comment",
  "sectionId": "budgetAllocation"
}

### Step 4: Verify the grouped comments structure
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

### Specifically check the comments response
# @name getSubmissionComments
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

> {%
    const response = JSON.parse(responseBody);
    if (response && response.data && response.data.reviewComments) {
        const comments = response.data.reviewComments;
        
        console.log("=== COMMENT STRUCTURE ===");
        console.log(JSON.stringify(comments, null, 2));
        
        // Check if the structure is grouped by section numbers
        if (typeof comments === 'object' && !Array.isArray(comments)) {
            console.log("\n=== STRUCTURE VERIFIED ===");
            console.log("Comments are correctly grouped by section numbers!");
            
            // Show the total counts by section
            for (const sectionNumber in comments) {
                console.log(`Section ${sectionNumber}: ${comments[sectionNumber].length} comments`);
            }
        } else {
            console.log("\n=== STRUCTURE ERROR ===");
            console.log("Comments are not grouped by section numbers as expected!");
        }
    } else {
        console.log("No comments found or invalid response format");
    }
%}