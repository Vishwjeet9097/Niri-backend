# Comment Grouping API Test Guide

# This file demonstrates how to test the new comment grouping functionality that
# groups comments by sections for better organization and display.

### Environment Variables
@baseUrl = http://localhost:3000
@nodalToken = {{nodalLogin.response.body.$.data.accessToken}}
@stateToken = {{stateLogin.response.body.$.data.accessToken}}
@mospiToken = {{mospiLogin.response.body.$.data.accessToken}}
@submissionId = {{createSubmission.response.body.$.data.id}}

### Step 1: Login as NODAL_OFFICER
# @name nodalLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nodal@niri.gov.in",
  "password": "Nodal@123"
}

### Step 2: Login as STATE_APPROVER
# @name stateLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "state@niri.gov.in",
  "password": "State@123"
}

### Step 3: Login as MOSPI_APPROVER
# @name mospiLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@niri.gov.in",
  "password": "Admin@123"
}

### Step 4: Create a new submission with multiple sections
# @name createSubmission
POST {{baseUrl}}/submission
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "submissionId": "TEST-GROUPING-{{$timestamp}}",
  "formData": {
    "infrastructureMetrics": {
      "qualityIndex": 8.5,
      "socialImpact": 7.8,
      "transportationAccess": 9.1
    },
    "performanceMetrics": {
      "efficiency": 7.9,
      "reliability": 8.3,
      "userSatisfaction": 7.5
    },
    "qualityMetrics": {
      "standardsCompliance": 9.2,
      "errorRate": 1.3,
      "serviceUptime": 99.8
    },
    "projectDetails": {
      "name": "Test Project for Comment Grouping",
      "startDate": "2025-06-01",
      "completionDate": "2025-09-30",
      "budget": 500000
    }
  }
}

### Step 5: Add comments to different sections as STATE_APPROVER
# General section comment
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{stateToken}}

{
  "text": "This is a general comment about the entire submission",
  "type": "comment",
  "sectionId": "general"
}

### Infrastructure metrics section comment
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{stateToken}}

{
  "text": "Please verify the social impact metrics with the latest survey data",
  "type": "comment",
  "sectionId": "infrastructureMetrics"
}

### Performance metrics section comment
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{stateToken}}

{
  "text": "The efficiency metrics need to be compared with previous year data",
  "type": "comment",
  "sectionId": "performanceMetrics"
}

### Step 6: Add comments to different sections as MOSPI_APPROVER
# Quality metrics section comment
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{mospiToken}}

{
  "text": "Standards compliance seems too high. Please provide supporting documents.",
  "type": "comment",
  "sectionId": "qualityMetrics"
}

### Project details section comment
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{mospiToken}}

{
  "text": "The budget allocation needs to be broken down by category",
  "type": "comment",
  "sectionId": "projectDetails"
}

### Subsection comment example
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{mospiToken}}

{
  "text": "Transportation access data seems outdated",
  "type": "comment",
  "sectionId": "infrastructureMetrics.transportationAccess"
}

### Approval comment
POST {{baseUrl}}/submission/{{submissionId}}/comment
Content-Type: application/json
Authorization: Bearer {{mospiToken}}

{
  "text": "Overall submission meets basic requirements",
  "type": "approval",
  "sectionId": "approval-notes"
}

### Step 7: Test the comment grouping endpoint
# @name testGrouping
GET {{baseUrl}}/submission/test/comments/{{submissionId}}
Authorization: Bearer {{mospiToken}}

### Step 8: View the full submission with grouped comments
# @name getSubmission
GET {{baseUrl}}/submission/{{submissionId}}
Authorization: Bearer {{mospiToken}}

### Step 9: Extract and display the grouped comments
# @name extractGroupedComments
GET {{baseUrl}}/submission/{{submissionId}}
Authorization: Bearer {{mospiToken}}

> {%
    const response = JSON.parse(responseBody);
    if (response && response.data) {
        // Check for the new commentsBySection property
        if (response.data.commentsBySection) {
            console.log("=== GROUPED COMMENTS BY SECTION ===");
            const commentsBySection = response.data.commentsBySection;
            
            // Display comments for each section
            for (const sectionNumber in commentsBySection) {
                console.log(`\n## Section ${sectionNumber}:`);
                
                commentsBySection[sectionNumber].forEach((comment, index) => {
                    console.log(`${index + 1}. [${comment.role}] ${comment.text}`);
                    console.log(`   Type: ${comment.type}, Section ID: ${comment.sectionId}`);
                    console.log(`   Added: ${new Date(comment.timestamp).toLocaleString()}`);
                });
            }
            
            // Output summary statistics
            let totalComments = 0;
            let sectionCounts = {};
            
            for (const section in commentsBySection) {
                const count = commentsBySection[section].length;
                totalComments += count;
                sectionCounts[section] = count;
            }
            
            console.log("\n=== COMMENT STATISTICS ===");
            console.log(`Total comments: ${totalComments}`);
            console.log("Comments per section:");
            
            for (const section in sectionCounts) {
                console.log(`- Section ${section}: ${sectionCounts[section]} comments`);
            }
        } else {
            console.log("commentsBySection property not found in the response");
            console.log("Make sure you've implemented the comment grouping functionality");
        }
    } else {
        console.log("Invalid response format");
    }
%}

### Alternative: Test with hardcoded submission ID
# If you want to test with an existing submission, replace YOUR_SUBMISSION_UUID with a real UUID
# @name testWithHardcodedId
GET {{baseUrl}}/submission/test/comments/YOUR_SUBMISSION_UUID
Authorization: Bearer {{mospiToken}}

### Notes:
# 1. This test file assumes you have registered the necessary users (NODAL_OFFICER, STATE_APPROVER, MOSPI_APPROVER)
# 2. If you get 401 Unauthorized errors, make sure to register the users first
# 3. The comment grouping functionality should add a 'commentsBySection' property to the response
# 4. Check the JavaScript processing in Step 9 to see how the grouped comments are displayed
# 5. The test endpoint /submission/test/comments/:id specifically shows the comment grouping in action