{
  "info": {
    "name": "NIRI Indicators API Collection",
    "description": "Complete API collection for NIRI Indicators feature implementation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@niri.gov.in\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register NODAL_OFFICER with Indicators",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nodal.officer@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"role\": \"NODAL_OFFICER\",\n  \"stateUt\": \"DL\",\n  \"contactNumber\": \"9876543210\",\n  \"indicatorCodes\": [\"1.1\", \"1.2\", \"2.1\", \"3.1\", \"4.1\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Indicators Management",
      "item": [
        {
          "name": "Get All Indicators",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/indicators",
              "host": ["{{base_url}}"],
              "path": ["indicators"]
            }
          }
        },
        {
          "name": "Get Indicators by Section",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/indicators/section/1",
              "host": ["{{base_url}}"],
              "path": ["indicators", "section", "1"]
            }
          }
        },
        {
          "name": "Get User Assigned Indicators",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/indicators",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "indicators"]
            }
          }
        }
      ]
    },
    {
      "name": "Submission with Indicators",
      "item": [
        {
          "name": "Create Submission (NODAL_OFFICER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": \"TEST-001\",\n  \"formData\": {\n    \"1.1\": {\n      \"capitalAllocation\": 1000000,\n      \"gsdpForFY\": 20000000,\n      \"percentage\": 5.0\n    },\n    \"1.2\": {\n      \"actualCapex\": 800000,\n      \"stateCapexUtilisation\": 1000000,\n      \"percentage\": 80.0\n    },\n    \"2.1\": {\n      \"available\": \"yes\",\n      \"files\": [\n        {\n          \"name\": \"infrastructure-act.pdf\",\n          \"url\": \"https://example.com/files/infrastructure-act.pdf\"\n        }\n      ]\n    },\n    \"3.1\": {\n      \"available\": \"yes\",\n      \"files\": [\n        {\n          \"name\": \"ppp-act.pdf\",\n          \"url\": \"https://example.com/files/ppp-act.pdf\"\n        }\n      ]\n    },\n    \"4.1\": {\n      \"allEligible\": \"yes\",\n      \"websiteLink\": \"https://nip.gov.in\",\n      \"projectCount\": 25\n    },\n    \"generalInfo\": {\n      \"stateName\": \"Delhi\",\n      \"year\": 2024,\n      \"submittedBy\": \"John Doe\"\n    }\n  },\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/submission",
              "host": ["{{base_url}}"],
              "path": ["submission"]
            }
          }
        },
        {
          "name": "Get Submission (Filtered for NODAL_OFFICER)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/submission/{{submission_id}}",
              "host": ["{{base_url}}"],
              "path": ["submission", "{{submission_id}}"]
            }
          }
        },
        {
          "name": "Update Submission (NODAL_OFFICER)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formData\": {\n    \"1.1\": {\n      \"capitalAllocation\": 1200000,\n      \"gsdpForFY\": 20000000,\n      \"percentage\": 6.0\n    },\n    \"1.2\": {\n      \"actualCapex\": 900000,\n      \"stateCapexUtilisation\": 1000000,\n      \"percentage\": 90.0\n    },\n    \"generalInfo\": {\n      \"stateName\": \"Delhi\",\n      \"year\": 2024,\n      \"lastUpdated\": \"2024-01-15T10:30:00Z\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/submission/{{submission_id}}",
              "host": ["{{base_url}}"],
              "path": ["submission", "{{submission_id}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Error Testing",
      "item": [
        {
          "name": "Try Unauthorized Indicator Access",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": \"TEST-UNAUTHORIZED\",\n  \"formData\": {\n    \"1.3\": {\n      \"creditRatedULBs\": 15,\n      \"totalULBs\": 20\n    },\n    \"2.4\": {\n      \"projectPipeline\": \"ready\",\n      \"projectCount\": 10\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/submission",
              "host": ["{{base_url}}"],
              "path": ["submission"]
            }
          }
        }
      ]
    },
    {
      "name": "User Management",
      "item": [
        {
          "name": "Create User with Indicators",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nodal.officer2@example.com\",\n  \"password\": \"password123\",\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"role\": \"NODAL_OFFICER\",\n  \"stateUt\": \"MH\",\n  \"contactNumber\": \"9876543211\",\n  \"indicatorCodes\": [\"1.3\", \"1.4\", \"2.2\", \"3.2\", \"4.2\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/create",
              "host": ["{{base_url}}"],
              "path": ["users", "create"]
            }
          }
        },
        {
          "name": "Update User Indicators",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"indicatorCodes\": [\"1.1\", \"1.2\", \"2.1\", \"2.2\", \"3.1\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/users/{{user_id}}/indicators",
              "host": ["{{base_url}}"],
              "path": ["users", "{{user_id}}", "indicators"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "submission_id",
      "value": "",
      "type": "string"
    }
  ]
}
