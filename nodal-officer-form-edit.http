# NODAL OFFICER FORM EDIT WORKFLOW
# This file demonstrates the process for a NODAL_OFFICER to edit their own form submissions
# IMPORTANT: API endpoints that use :id expect a UUID (not the custom submissionId)

@baseUrl = http://localhost:3000
@nodalToken = {{nodalLogin.response.body.$.data.accessToken}}
@stateToken = {{stateLogin.response.body.$.data.accessToken}}

### Step 1: Login as NODAL_OFFICER
# @name nodalLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nodal@niri.gov.in",
  "password": "Nodal@123"
}

### Step 2: Login as STATE_APPROVER (for later steps)
# @name stateLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "state@niri.gov.in",
  "password": "State@123"
}

### Step 3: List all submissions to find UUIDs
# Use this to find existing submissions or to verify new submissions
GET {{baseUrl}}/submission/list
Authorization: Bearer {{nodalToken}}

### SCENARIO 1: CREATE AND EDIT A DRAFT SUBMISSION
### ----------------------------------------------

### Step 4: Create a new draft submission
# @name createDraftSubmission
POST {{baseUrl}}/submission
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "submissionId": "NODAL-EDIT-DEMO-{{$timestamp}}",
  "formData": {
    "generalInformation": {
      "title": "Initial Draft Submission",
      "department": "Infrastructure",
      "referenceNumber": "DRAFT-2025-001",
      "submissionDate": "2025-10-14"
    },
    "infrastructureMetrics": {
      "qualityIndex": 7.0,
      "socialImpact": 6.5
    }
  }
}

### Store the submission UUID - this is what we'll use in URL paths
@submissionUuid = {{createDraftSubmission.response.body.$.data.id}}

### Step 5: Verify the new submission
# Confirm it was created with the initial data
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

### Step 6: Edit the draft submission
# NODAL_OFFICER can edit their own draft submissions
PUT {{baseUrl}}/submission/{{submissionUuid}}
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "formData": {
    "generalInformation": {
      "title": "Updated Draft Submission",
      "department": "Infrastructure Planning",
      "referenceNumber": "DRAFT-2025-001-REV",
      "submissionDate": "2025-10-14"
    },
    "infrastructureMetrics": {
      "qualityIndex": 8.5,
      "socialImpact": 7.5,
      "economicGrowth": 9.0
    },
    "additionalComments": {
      "notes": "Added new data on economic growth impact"
    }
  }
}

### Step 7: Verify the updated submission
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

### SCENARIO 2: EDIT AFTER REJECTION/RETURN
### ---------------------------------------

### Step 8: Submit the form to state
POST {{baseUrl}}/submission/submit-to-state/{{submissionUuid}}
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "comment": "Submitting for state review",
  "sectionId": "general"
}

### Step 9: Verify the status changed
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

### Step 10: STATE_APPROVER rejects/returns the submission
POST {{baseUrl}}/submission/send-back-to-state/{{submissionUuid}}
Content-Type: application/json
Authorization: Bearer {{stateToken}}

{
  "comment": "Please revise the economic growth figures and add supporting documentation",
  "sectionId": "infrastructureMetrics.economicGrowth"
}

### Step 11: Verify submission was returned to NODAL_OFFICER
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

### Step 12: NODAL_OFFICER edits the returned submission
PUT {{baseUrl}}/submission/{{submissionUuid}}
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "formData": {
    "infrastructureMetrics": {
      "economicGrowth": 8.2,
      "supportingData": "Revised based on Q3 2025 economic indicators"
    },
    "additionalComments": {
      "notes": "Updated economic growth figures as requested",
      "dataSource": "Ministry of Finance Economic Survey 2025"
    }
  }
}

### Step 13: Verify the edits to the returned submission
GET {{baseUrl}}/submission/{{submissionUuid}}
Authorization: Bearer {{nodalToken}}

### Step 14: Resubmit to state after making requested changes
POST {{baseUrl}}/submission/submit-to-state/{{submissionUuid}}
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "comment": "Revised and resubmitting with updated economic growth data",
  "sectionId": "infrastructureMetrics.economicGrowth"
}

### SCENARIO 3: WORK WITH EXISTING SUBMISSION
### -----------------------------------------

### Step 15: Find an existing submission to edit
# @name findSubmissions
GET {{baseUrl}}/submission/list?status=DRAFT
Authorization: Bearer {{nodalToken}}

# Once you find a submission ID from the response above,
# use it in the requests below (replace YOUR-UUID-HERE)

### Step 16: Edit an existing submission (replace with actual UUID)
PUT {{baseUrl}}/submission/YOUR-UUID-HERE
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "formData": {
    "generalInformation": {
      "title": "Updated Existing Submission",
      "department": "Updated Department"
    },
    "infrastructureMetrics": {
      "qualityIndex": 9.0
    }
  }3
}

### ADDITIONAL OPERATIONS
### --------------------

### Add a comment to your own submission
POST {{baseUrl}}/submission/{{submissionUuid}}/comment
Content-Type: application/json
Authorization: Bearer {{nodalToken}}

{
  "text": "Self-note: Need to verify budget allocation figures before final submission",
  "type": "comment",
  "sectionId": "budgetAllocation"
}

### Get all comments on a submission
GET {{baseUrl}}/submission/{{submissionUuid}}/comments
Authorization: Bearer {{nodalToken}}

### Check submission status history
GET {{baseUrl}}/submission/{{submissionUuid}}/history
Authorization: Bearer {{nodalToken}}