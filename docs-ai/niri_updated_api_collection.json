{
  "info": {
    "name": "NIRI Backend API - Updated Collection",
    "description": "Updated API collection for National Infrastructure Readiness Index (NIRI) Backend System with Recent Activities Dashboard and REJECTED Status Support",
    "version": "2.2.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "submissionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "filePath",
      "value": "",
      "type": "string"
    },
    {
      "key": "stateApproverToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "mospiReviewerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "mospiApproverToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/summary",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "summary"]
            }
          },
          "response": []
        },
        {
          "name": "Get Role-Specific KPIs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/kpis",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "kpis"]
            }
          },
          "response": []
        },
        {
          "name": "Get Recent Activities",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard/recent-activities",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "recent-activities"]
            }
          },
          "response": [
            {
              "name": "Recent Activities Response",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/dashboard/recent-activities",
                  "host": ["{{baseUrl}}"],
                  "path": ["dashboard", "recent-activities"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "[\n  {\n    \"id\": \"uuid\",\n    \"submissionId\": \"SUB-MH-2024-001\",\n    \"title\": \"Digital Infrastructure Survey\",\n    \"status\": \"APPROVED\",\n    \"statusLabel\": \"Approved\",\n    \"statusColor\": \"green\",\n    \"stateUt\": \"Maharashtra\",\n    \"submittedBy\": \"Rajesh Kumar\",\n    \"submittedByRole\": \"NODAL_OFFICER\",\n    \"updatedAt\": \"2025-01-14T10:30:00.000Z\",\n    \"createdAt\": \"2025-01-13T09:15:00.000Z\"\n  },\n  {\n    \"id\": \"uuid\",\n    \"submissionId\": \"SUB-MH-2024-002\",\n    \"title\": \"PPP Project Assessment\",\n    \"status\": \"REJECTED\",\n    \"statusLabel\": \"Returned\",\n    \"statusColor\": \"orange\",\n    \"stateUt\": \"Maharashtra\",\n    \"submittedBy\": \"Priya Sharma\",\n    \"submittedByRole\": \"STATE_APPROVER\",\n    \"updatedAt\": \"2025-01-13T14:45:00.000Z\",\n    \"createdAt\": \"2025-01-12T11:20:00.000Z\"\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "name": "Submission Workflow - Updated",
      "item": [
        {
          "name": "Create Submission",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('submissionId', response.id);",
                  "    console.log('Submission created:', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"submissionId\": \"SUB-MH-2024-001\",\n  \"formData\": {\n    \"capexToGsdpRatio\": 5.5,\n    \"infrastructureInvestment\": 1000,\n    \"projectCompletionRate\": 85,\n    \"qualityIndex\": 8.5,\n    \"sustainabilityScore\": 7.5,\n    \"innovationIndex\": 6.5,\n    \"digitalInfrastructure\": 9.0,\n    \"environmentalCompliance\": 8.0,\n    \"socialImpact\": 7.8,\n    \"economicGrowth\": 6.2\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submission",
              "host": ["{{baseUrl}}"],
              "path": ["submission"]
            }
          },
          "response": []
        },
        {
          "name": "State Reject (Updated)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{stateApproverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"comment\": \"Submission rejected due to incomplete data and missing documentation.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submission/state-reject/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["submission", "state-reject", "{{submissionId}}"]
            }
          },
          "response": [
            {
              "name": "State Reject Response",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"REJECTED\",\n  \"comment\": \"Submission rejected due to incomplete data and missing documentation.\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/submission/state-reject/{{submissionId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["submission", "state-reject", "{{submissionId}}"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"status\": true,\n  \"data\": {\n    \"id\": \"uuid\",\n    \"submissionId\": \"SUB-MH-2024-001\",\n    \"status\": \"REJECTED\",\n    \"currentOwnerRole\": \"NODAL_OFFICER\",\n    \"reviewComments\": [\n      {\n        \"timestamp\": \"2025-01-14T10:30:00.000Z\",\n        \"role\": \"STATE_APPROVER\",\n        \"userId\": \"uuid\",\n        \"text\": \"Submission rejected due to incomplete data and missing documentation.\",\n        \"type\": \"rejection\"\n      }\n    ],\n    \"updatedAt\": \"2025-01-14T10:30:00.000Z\"\n  },\n  \"message\": \"Submission rejected and returned to Nodal Officer\",\n  \"timestamp\": \"2025-01-14T10:30:00.000Z\"\n}"
            }
          ]
        },
        {
          "name": "Resubmit (After Rejection)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"formData\": {\n    \"capexToGsdpRatio\": 6.2,\n    \"infrastructureInvestment\": 1100,\n    \"projectCompletionRate\": 88,\n    \"qualityIndex\": 8.8,\n    \"sustainabilityScore\": 7.8,\n    \"innovationIndex\": 6.8,\n    \"additionalClarification\": \"Detailed infrastructure metrics provided\"\n  },\n  \"comment\": \"Resubmitted with additional clarification and updated metrics.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submission/resubmit/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["submission", "resubmit", "{{submissionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Approve Submission",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mospiApproverToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"comment\": \"Submission approved after review.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/submission/approve/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["submission", "approve", "{{submissionId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login - Nodal Officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('authToken', response.accessToken);",
                  "    pm.collectionVariables.set('userId', response.user.id);",
                  "    console.log('Nodal Officer logged in:', response.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nodal.officer@maharashtra.gov.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login - State Approver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('stateApproverToken', response.accessToken);",
                  "    console.log('State Approver logged in:', response.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"state.approver@maharashtra.gov.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Login - MoSPI Approver",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('mospiApproverToken', response.accessToken);",
                  "    console.log('MoSPI Approver logged in:', response.user.email);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mospi.approver@gov.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
