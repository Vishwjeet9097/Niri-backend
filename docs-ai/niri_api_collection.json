            "url": {
              "raw": "{{baseUrl}}/submission/final-reject/{{submissionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["submission", "final-reject", "{{submissionId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Approve Submission",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
