@baseUrl = http://localhost:3000
@nodalToken = {{nodalLogin.response.body.$.data.accessToken}}
@stateApproverToken = {{stateLogin.response.body.$.data.accessToken}}
@reviewerToken = {{reviewerLogin.response.body.$.data.accessToken}}
@approverToken = {{approverLogin.response.body.$.data.accessToken}}
@submissionId = {{createSubmission.response.body.$.data.id}}

### Step 1: Login as NODAL_OFFICER
# @name nodalLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nodal@niri.gov.in",
  "password": "Nodal@123"
}

### Step 2: Login as STATE_APPROVER
# @name stateLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "state@niri.gov.in",
  "password": "State@123"
}

### Step 3: Login as MOSPI_REVIEWER
